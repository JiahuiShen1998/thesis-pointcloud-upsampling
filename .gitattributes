# Keep original bytes so SHA256SUMS remains valid after cloning.
* -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text
*.pptx filter=lfs diff=lfs merge=lfs -text
*.npy filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text

# Standalone visualization exports contain embedded plotting libraries and data.
research/modelnet40/results/figures/**/*.html linguist-generated=true
presentation/modelnet40_materials/*.html linguist-generated=true
# Saved upstream architecture copies accompany each archived training run.
research/modelnet40/results/pointnet2_final_runs/**/pointnet2_cls_ssg.py linguist-vendored=true
research/modelnet40/results/pointnet2_final_runs/**/pointnet2_utils.py linguist-vendored=true
